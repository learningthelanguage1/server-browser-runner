[Unit]
Description=FunFluen Linux Browser Agent Runner
After=network.target ff-runner-xvfb.service ff-runner-wm.service
Requires=ff-runner-xvfb.service

[Service]
User=ffrunner
WorkingDirectory=/srv/ff-browser-runner/app
Environment=NODE_ENV=production
Environment=DISPLAY=:99
EnvironmentFile=-/srv/ff-browser-runner/config/runner.env
ExecStart=/usr/bin/node dist/index.js --config /srv/ff-browser-runner/config/runner.yaml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
